clean_contributing_factor <- function(df, col_name) {
df[[col_name]] <- tolower(df[[col_name]])
df[[col_name]][df[[col_name]] == "illnes"] <- "illness"
df[[col_name]][df[[col_name]] %in% c("1", "80")] <- NA
return(df)
}
# Aplicas la función para cada columna:
cols <- paste0("CONTRIBUTING.FACTOR.VEHICLE.", 1:5)
for (col in cols) {
motors_df <- clean_contributing_factor(motors_df, col)
}
sort(unique(motors_df$VEHICLE.TYPE.CODE.3))
# Función de limpieza
clean_vehicle_type <- function(vec) {
x <- tolower(vec)
x <- str_squish(x)
x <- gsub("-", "", x)
x[x == "?omme"] <- NA
is_door <- !is.na(x) & grepl("^\\s*\\d+.*\\b(d|dr|doo|door)\\b", x, ignore.case = TRUE)
x[is_door] <- "door"
is_amazon <- !is.na(x) & grepl("amazon", x, ignore.case = TRUE)
x[is_amazon] <- "delivery"
is_ambul <- !is.na(x) & grepl("^(amb|abul|abula|amabu|amab|almb|amul|ambu|ambul)", x, ignore.case = TRUE)
x[is_ambul] <- "ambulance"
candidates_idx <- which(!is.na(x) & x != "ambulance")
if (length(candidates_idx) > 0) {
approx_match <- vapply(x[candidates_idx],
function(s) length(agrep("ambulance", s, max.distance = 2, ignore.case = TRUE)) > 0,
logical(1))
if (any(approx_match)) {
x[candidates_idx[approx_match]] <- "ambulance"
}
}
is_bike <- !is.na(x) & grepl("^(bicyc|bicycle|bike|bk)\\b", x, ignore.case = TRUE)
x[is_bike] <- "bike"
is_backhoe <- !is.na(x) & grepl("^(back ?hoe|backh|backhoe)", x, ignore.case = TRUE)
x[is_backhoe] <- "backhoe"
is_commercial <- !is.na(x) & grepl("^(commer|commm|commercial|commeric|commerical)", x, ignore.case = TRUE)
x[is_commercial] <- "commercial"
is_delivery <- !is.na(x) & grepl("\\b(deliv|del|delivery|deiv|delvi|delv|delvbr|delvwh|delivry)\\b", x, ignore.case = TRUE)
x[is_delivery] <- "delivery"
x[grepl("^\\s*\\d+\\s*$", x)] <- NA
return(x)
}
# Columnas a limpiar
cols_to_clean <- paste0("VEHICLE.TYPE.CODE.", 1:5)
# Guardar respaldo y limpiar
for (col in cols_to_clean) {
motors_df[[paste0(col, "_original")]] <- motors_df[[col]]
motors_df[[col]] <- clean_vehicle_type(motors_df[[col]])
}
