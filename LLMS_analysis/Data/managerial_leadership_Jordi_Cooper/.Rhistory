clean_street <- function(x) {
x <- as.character(x)
# Mantener NA como NA
na_idx <- is.na(x)
x[na_idx] <- ""
x <- str_trim(x)                      # quitar espacios al inicio/final
x <- str_replace_all(x, "\\.", "")    # quitar puntos
x <- str_replace_all(x, "[,\\/\\-\\&]", " ") # reemplazar signos comunes por espacio
x <- str_replace_all(x, "\\s+", " ")  # múltiples espacios -> uno
x <- str_to_upper(x)                  # mayúsculas para coincidencias consistentes
# Quitar sufijos ordinales pegados al número: 108TH, 1ST, 2ND, 3RD -> 108, 1, 2, 3
x <- str_replace_all(x, "(\\d+)(?:TH|ST|ND|RD)\\b", "\\1")
# Diccionario de abreviaturas (patrones con \b para límites de palabra)
repl <- c(
"\\bAVE\\b" = "AVENUE",
"\\bAV\\b"  = "AVENUE",
"\\bAVENUE\\b" = "AVENUE",
"\\bST\\b"  = "STREET",
"\\bSTR\\b" = "STREET",
"\\bSTREET\\b" = "STREET",
"\\bPL\\b"  = "PLACE",
"\\bPLZ\\b" = "PLAZA",
"\\bBLVD\\b"= "BOULEVARD",
"\\bBOULEVARD\\b" = "BOULEVARD",
"\\bDR\\b"  = "DRIVE",
"\\bDRIVE\\b" = "DRIVE",
"\\bRD\\b"  = "ROAD",
"\\bROAD\\b" = "ROAD",
"\\bLN\\b"  = "LANE",
"\\bLANE\\b" = "LANE",
"\\bPKWY\\b"= "PARKWAY",
"\\bCTR\\b" = "CENTER",
"\\bCT\\b"  = "COURT"
)
# Reemplazar usando el diccionario
x <- str_replace_all(x, repl)
# Normalizar guiones/puntos extra y colapsar espacios
x <- str_squish(x)
# volver a NA los que estaban NA originalmente o quedaron vacíos
x[x == ""] <- NA
x[na_idx] <- NA
return(x)
}
# Aplicar sobre la columna ON.STREET.NAME (usar [[ ]] por seguridad con nombres con puntos)
