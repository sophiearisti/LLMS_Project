Cell[BoxData[
 RowBox[{
  RowBox[{"choice", "[", 
   RowBox[{"att_", ",", "lambda_", ",", "step_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pdf", ",", "sum", ",", "cdf", ",", "rand", ",", "i", ",", "cum", ",", 
      "choice"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"att", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"pcloss", "[", 
             RowBox[{"a", ",", "x", ",", "loss"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "28", ",", "step2"}], "}"}]}], "]"}],
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "0", ",", "28", ",", "step1"}], "}"}]}], "]"}]}], 
      ";"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Print", "[", "att", "]"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pdf", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"lambda", "*", "att"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Plus", "@@", "pdf"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cdf", "=", 
      RowBox[{"pdf", "/", "sum"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rand", "=", 
      RowBox[{"Random", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cum", "=", 
      RowBox[{"cdf", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"rand", ">", "cum"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"cum", "+=", 
         RowBox[{"cdf", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"choice", "=", 
      RowBox[{"step", "*", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "choice", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7774941284448423`*^9, 3.777494203806308*^9}, {
