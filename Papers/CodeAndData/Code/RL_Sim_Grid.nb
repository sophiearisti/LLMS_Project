Cell[BoxData[
 RowBox[{
  RowBox[{"attEvolution", "[", 
   RowBox[{
   "att_", ",", "weight_", ",", "choice_", ",", "step_", ",", "pay_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"new", ",", "part", ",", "att1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"part", "=", 
      RowBox[{"IntegerPart", "[", 
       RowBox[{
        RowBox[{"choice", "/", "step"}], "+", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "part", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"new", "=", 
      RowBox[{
       RowBox[{"weight", "*", 
        RowBox[{"att", "[", 
         RowBox[{"[", "part", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1.0", "-", "weight"}], ")"}], "*", "pay"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "new", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"att1", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"att", ",", 
        RowBox[{"part", "\[Rule]", "new"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "att1", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "att1", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
